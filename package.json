{
  "name": "certification-overdrive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run validate:questions && vite --host 0.0.0.0",
    "build": "npm run validate:questions && npm run test:questions && npm run test:selection && npm run test:study && npm run test:glossary && npm run test:terms && npm run test:mastery && npm run test:audio && npm run test:mission-save && npm run test:haptics && npm run test:profile && npm run test:titles && npm run test:history && npm run test:ui && npm run audit:questions && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate:questions": "node scripts/build-question-bank.mjs",
    "test:questions": "node --test scripts/question-bank.test.mjs",
    "test:study": "node --experimental-strip-types --test scripts/study-scheduler.test.mjs",
    "test:glossary": "node --experimental-strip-types --test scripts/glossary.test.mjs",
    "audit:questions": "node scripts/audit-question-bank.mjs",
    "test:mastery": "node --experimental-strip-types --test scripts/mastery.test.mjs",
    "test:audio": "node --experimental-strip-types --test scripts/audio.test.mjs",
    "test:terms": "node --experimental-strip-types --test scripts/term-guide.test.mjs",
    "test:mission-save": "node --experimental-strip-types --test scripts/mission-save.test.mjs",
    "test:haptics": "node --experimental-strip-types --test scripts/haptics.test.mjs",
    "test:profile": "node --experimental-strip-types --test scripts/game-profile.test.mjs",
    "test:ui": "node --test scripts/ui-hierarchy.test.mjs",
    "test:history": "node --experimental-strip-types --test scripts/study-history.test.mjs",
    "test:titles": "node --experimental-strip-types --test scripts/title-system.test.mjs",
    "test:selection": "node --experimental-strip-types --test scripts/question-selection.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
